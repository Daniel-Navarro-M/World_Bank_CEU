# Rubins Rules Pooling Function
fit_pv_model <- function(rhs, dataset) {
pv_vars <- c("ASMMAT01", "ASMMAT02", "ASMMAT03", "ASMMAT04", "ASMMAT05")
model_list <- vector("list", length(pv_vars))
for(i in seq_along(pv_vars)) {
pv <- pv_vars[i]
formula_i <- as.formula(paste(pv, "~", rhs))
model_list[[i]] <- lm(formula_i, data = dataset, weights = dataset$TOTWGT)
}
pool(as.mira(model_list))
}
##### 1.1 NEW MODEL SETUP ####
df_panel <- df_panel |>
mutate(
env_discuss = ifelse(ASBH09A_rev %in% c(998, 999), NA, ASBH09A_rev),
books_score           = ifelse(books_score %in% c(998, 999), NA, books_score),
children_books_score  = ifelse(children_books_score %in% c(998, 999), NA, children_books_score),
home_resources_learning_rev = ifelse(
home_resources_learning_rev %in% c(998, 999), NA, home_resources_learning_rev
),
teacher_parental_involvement_rev = ifelse(
teacher_parental_involvement_rev %in% c(998, 999), NA, teacher_parental_involvement_rev
)
)
# Rebuild subsamples to pick up cleaned variables
df_balkan   <- df_panel |> filter(Is_balkan == 1)
df_european <- df_panel |> filter(Is_balkan == 0)
# Sanity check: confirm env_discuss has variation in both waves
df_panel |>
group_by(year) |>
summarise(
n         = n(),
n_missing = sum(is.na(env_discuss)),
mean      = mean(env_discuss, na.rm = TRUE),
sd        = sd(env_discuss,   na.rm = TRUE)
)
# Sanity check: confirm books_score is not all-NA in 2024
df_panel |>
group_by(year) |>
summarise(
books_missing          = sum(is.na(books_score)),
children_books_missing = sum(is.na(children_books_score))
)
pv_vars <- paste0("ASMMAT0", 1:5)
check_formula_levels <- function(data, rhs) {
for (pv in pv_vars) {
f <- as.formula(paste(pv, "~", rhs))
mf <- model.frame(f, data = data, na.action = na.omit)
cat("\n", pv, "\n", sep = "")
cat("rows:", nrow(mf), "\n")
cat("IDCNTRY levels:", nlevels(factor(mf$`as.factor(IDCNTRY)`)), "\n")
cat("year levels:", nlevels(factor(mf$`as.factor(year)`)), "\n")
cat("IDCNTRY values:", paste(unique(mf$`as.factor(IDCNTRY)`), collapse = ", "), "\n")
cat("year values:", paste(unique(mf$`as.factor(year)`), collapse = ", "), "\n")
}
}
check_formula_levels(
df_panel,
"home_resources_learning_rev + parent_edu_binary + as.factor(IDCNTRY) + as.factor(year)"
)
m10_panel_pv_ctry    <- fit_pv_model("home_resources_learning_rev + parent_edu_binary + as.factor(IDCNTRY) + as.factor(year)", df_panel)
m10_panel_pv_schl    <- fit_pv_model("home_resources_learning_rev + parent_edu_binary + as.factor(IDSCHOOL) + as.factor(year)", df_panel)
