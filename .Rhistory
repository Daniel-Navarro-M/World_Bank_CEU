pv_vars <- paste0("ASMMAT0", 1:5)
check_formula_levels <- function(data, rhs) {
for (pv in pv_vars) {
f <- as.formula(paste(pv, "~", rhs))
mf <- model.frame(f, data = data, na.action = na.omit)
cat("\n", pv, "\n", sep = "")
cat("rows:", nrow(mf), "\n")
cat("IDCNTRY levels:", nlevels(factor(mf$`as.factor(IDCNTRY)`)), "\n")
cat("year levels:", nlevels(factor(mf$`as.factor(year)`)), "\n")
cat("IDCNTRY values:", paste(unique(mf$`as.factor(IDCNTRY)`), collapse = ", "), "\n")
cat("year values:", paste(unique(mf$`as.factor(year)`), collapse = ", "), "\n")
}
}
check_formula_levels(
df_panel,
"home_resources_learning_rev + parent_edu_binary + as.factor(IDCNTRY) + as.factor(year)"
)
load("data/processed_data/master/master_longitudinal_processed.RData")
library(fixest)
library(modelsummary)
library(gt)
library(webshot2)
library(tidyverse)
library(dplyr)
#### 0. Load & Clean Data ####
master <- master_longitudinal_processed
haven::as_factor(master$IDCNTRY)
attributes(master$IDCNTRY)
# Check data
unique(master$CountryName)
names(master)
master |>
filter(IDCNTRY == 705) |>
count(year)
# Select just panel data — keep only students observed in both waves
df_panel <- master |>
filter(year %in% c(2023, 2024)) |>
group_by(IDSTUD, IDCNTRY) |>
filter(n_distinct(year) == 2) |>
arrange(year) |>
mutate(
student_id        = paste(IDCNTRY, IDSTUD, sep = "_"),
parent_edu_binary = ifelse(parent_edu_binary %in% c(9, 99, 998, 999), NA, parent_edu_binary),
PI_index          = ifelse(PI_index == 999, NA, PI_index),
PI_binary         = ifelse(PI_binary %in% c(9, 99, 998, 999), NA, PI_binary),
PI_read           = ifelse(PI_read%in% c(9, 99, 998, 999), NA, PI_read),
PI_math           = ifelse(PI_math%in% c(9, 99, 998, 999), NA, PI_math),
low_edu           = 1 - parent_edu_binary,
country_year      = paste(IDCNTRY, year, sep = "_")
) |>
mutate(
parent_edu_binary = ifelse(
is.na(parent_edu_binary) & year == 2024,
parent_edu_binary[year == 2023][1],
parent_edu_binary
),
low_edu = 1 - parent_edu_binary   # recalculate after fill
) |>
ungroup()
# ── Sanity checks ─────────────────────────────────────────────
n_distinct(df_panel$student_id)
nrow(df_panel)
table(df_panel$year)
# Parental Investment is held constant from 2023
# Parent Edu should have very low levels of change
df_panel |>
group_by(student_id) |>
summarise(
edu_varies = n_distinct(parent_edu_binary, na.rm = TRUE) > 1,
PI_varies  = n_distinct(PI_index, na.rm = TRUE) > 1
) |>
summarise(
students_edu_varies = sum(edu_varies),
students_PI_varies  = sum(PI_varies)
)
# Checks for missing outcome variables
df_panel |>
group_by(year) |>
summarise(
across(ASMMAT01:ASMMAT05, list(missing = ~sum(is.na(.)), mean = ~mean(., na.rm = TRUE))),
n = n()
) |>
print(width = Inf)
# ── Subsamples ────────────────────────────────────────────────
# Balkans  = Kosovo, Montenegro, North Macedonia
# European = Italy, Sweden, Slovenia
# ── Subsamples ────────────────────────────────────────────────
# Balkans  = Kosovo (411), Montenegro (499), North Macedonia (807)
# European = Italy (380), Slovenia (705), Sweden (752)
df_panel <- df_panel |>
mutate(
Is_balkan = if_else(IDCNTRY %in% c(411, 499, 807), 1, 0)
)
# verify
df_panel |> count(CountryName, Is_balkan)
df_balkan   <- df_panel |> filter(Is_balkan == 1)
df_european <- df_panel |> filter(Is_balkan == 0)
# Check country counts — report in paper
cat("European countries:", n_distinct(df_european$IDCNTRY), "\n")
cat("Balkan countries:",   n_distinct(df_balkan$IDCNTRY),   "\n")
unique(df_panel$CountryName)
## Temp fixes for things that need to be corrected in the master ##
# ── Fix 1: home_resources_learning_rev for 2023 ────────────────
df_panel <- df_panel |>
mutate(
home_resources_learning_rev = case_when(
!is.na(home_resources_learning_rev) ~ home_resources_learning_rev,
ASDGHRL %in% c(1, 2, 3)            ~ 4 - as.numeric(ASDGHRL),
TRUE                                ~ NA_real_
)
)
# ── Fix 2: teacher_parental_involvement_rev for 2024 ───────────
# ATBG06E  = 2023 teacher rating (already in df_panel)
# ATBLG06E = 2024 teacher rating (already in df_panel)
# Pipeline used if_else(year==2023, ATBG06E, ATBLG06E) but 2024
# rows ended up NA — reconstruct directly
# Original scale confirmed as 1-5, reverse scored as 6 - raw
# Treat 998/999 (pipeline missing codes) as NA
df_panel <- df_panel |>
mutate(
teacher_parental_involvement_rev = case_when(
# Keep existing valid 2023 values
year == 2023 & !is.na(teacher_parental_involvement_rev) ~
teacher_parental_involvement_rev,
# Reconstruct 2023 from raw if missing
year == 2023 & ATBG06E %in% 1:5 ~
6 - as.numeric(ATBG06E),
# Reconstruct 2024 from ATBLG06E
year == 2024 & ATBLG06E %in% 1:5 ~
6 - as.numeric(ATBLG06E),
TRUE ~ NA_real_
)
)
# ── Rebuild subsamples ──────────────────────────────────────────
df_balkan   <- df_panel |> filter(Is_balkan == 1)
df_european <- df_panel |> filter(Is_balkan == 0)
# ── Verify both fixes ───────────────────────────────────────────
df_panel |>
group_by(year) |>
summarise(
n                      = n(),
home_resources_valid   = sum(!is.na(home_resources_learning_rev)),
home_resources_mean    = round(mean(home_resources_learning_rev, na.rm = TRUE), 3),
teacher_pi_valid       = sum(!is.na(teacher_parental_involvement_rev)),
teacher_pi_mean        = round(mean(teacher_parental_involvement_rev, na.rm = TRUE), 3)
) |>
print(width = Inf)
# ── Shared setup ──────────────────────────────────────────────
pv_vars   <- paste0("ASMMAT0", 1:5)
avg_coefs <- function(model_list) {
coef_matrix <- sapply(model_list, coef)
if (is.matrix(coef_matrix)) rowMeans(coef_matrix) else coef_matrix
}
# install.packages ("mice")
library(mice)
# Rubins Rules Pooling Function
fit_pv_model <- function(rhs, dataset) {
pv_vars <- c("ASMMAT01", "ASMMAT02", "ASMMAT03", "ASMMAT04", "ASMMAT05")
model_list <- vector("list", length(pv_vars))
for(i in seq_along(pv_vars)) {
pv <- pv_vars[i]
formula_i <- as.formula(paste(pv, "~", rhs))
model_list[[i]] <- lm(formula_i, data = dataset, weights = dataset$TOTWGT)
}
pool(as.mira(model_list))
}
